# Copy to .env and fill in before running `npm run seed:admin`.

PORT=4787

# Signs admin login tokens. Any long random string — generate one with
# `openssl rand -hex 32`. Changing this logs every admin out.
JWT_SECRET=

# The one admin account. Run `npm run seed:admin` after setting these
# (or after changing ADMIN_PASSWORD, to rotate it) to write the account
# into the database — the server never reads these two at request time.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Comma-separated list of origins allowed to call this API (your frontend's
# dev server and, later, its real domain).
CORS_ORIGIN=http://localhost:5183

# Optional: where the SQLite file lives. Point this at a persistent disk's
# mount path on a host (e.g. Render); left unset, it defaults to server/data.
DATA_DIR=

# Optional: email a new-application notification to ADMIN_EMAIL via
# Resend (resend.com — free tier, no card required). Leave RESEND_API_KEY
# unset to skip email entirely; everything else still works.
RESEND_API_KEY=
RESEND_FROM=Her Crown <onboarding@resend.dev>
